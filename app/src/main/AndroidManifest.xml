<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hand tracking is this app's only input (pinch-hold-release charge/jump). The Spatial
         SDK AAR does NOT declare this permission for you — without it the tracking provider
         starts but never delivers data. -->
    <uses-permission android:name="com.picovr.permission.HAND_TRACKING" />

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_spatial_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_spatial_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpaceHopTheme"
        tools:targetApi="31"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.SpaceHopTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Volumetric DefaultWindowContainer 配置。应用启动落在这个窗口里；沉浸态的
                 Stage 不在 manifest 声明，改由 Main.kt 的 DSL 按 id 声明并在玩家点「进入沉浸」
                 时才打开。 -->

            <!-- 窗口 id。必须与 content/ContainerSwitch.kt 的 MAIN_WINDOW_ID 一致，否则从
                 沉浸态返回时 openWindowContainer 找不到它。 -->
            <meta-data
                android:name="pico.spatial.windowcontainer.id"
                android:value="SpaceHopVolume" />

            <!-- "2": Form.Volumetric —— 体积窗口，允许自定义深度。沙盘需要深度，平面窗口装不下。 -->
            <meta-data
                android:name="pico.spatial.windowcontainer.style"
                android:value="2" />

            <!-- 桌面摆件尺度。玩法几何固定（最远跳 0.55m、平台半径 0.09m、横向 ±0.08m，
                 合计约 0.73m 深 × 0.34m 宽），所以窗口里的场景必然是缩小的沙盘——
                 见 content/WindowScale.kt。 -->
            <meta-data
                android:name="pico.spatial.windowcontainer.defaultsize"
                android:value="0.5x0.4x0.45" />

            <meta-data
                android:name="pico.spatial.windowcontainer.defaultsize.unit"
                android:value="meters" />

            <!-- "2": WorldScale.Fixed —— 沙盘必须遵守真实透视，走近变大才对。
                 Dynamic 的「距离再远看上去也一样大」会毁掉摆件感。 -->
            <meta-data
                android:name="pico.spatial.windowcontainer.worldscaletype"
                android:value="2" />

            <!-- "1": UniformResizable —— 玩法几何锁死纵横比，非等比拉伸会把沙盘拉变形。 -->
            <meta-data
                android:name="pico.spatial.windowcontainer.resizerestriction"
                android:value="1" />

            <!-- "1": 底板隐藏 —— 与其它体积窗口项目同步关闭控制器射线悬停高亮条。
                 之前因为"它就是沙盘的桌面，青蛙站在上面"留着可见；青蛙实际在离散的跳跃
                 平台（StageVisuals 加载的模型）上落地，不是站在这块系统底板本身，如果
                 关掉后场景看起来在半空悬浮或缺一块可见地面，这是第一个要检查回退的地方。 -->
            <meta-data
                android:name="pico.spatial.windowcontainer.volumebasepanel"
                android:value="1" />

            <!-- "0": 关闭毛玻璃 —— 沙盘要看穿到真实房间。主窗口的毛玻璃只能在 manifest 关，
                 DSL 的 enableMaterialBackground 参数只作用于子窗口。 -->
            <meta-data
                android:name="pico.spatial.windowcontainer.materialbackground"
                android:value="0" />

        </activity><!-- Turn on SpatialUI's own logger. Its default level is None, so it discards even its
             own errors, which makes gesture/tracking issues invisible in logcat. -->
        <meta-data android:name="pico.spatial.ui.Logger" android:value="1" />

        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
